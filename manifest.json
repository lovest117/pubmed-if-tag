{
  "manifest_version": 3,
  "name": "Pubmed IF Tag",
  "version": "1.3.0",
  "description": "在PubMed搜索结果和文章页自动标注期刊影响因子（IF）、JCR分区与中科院分区",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://www.ncbi.nlm.nih.gov/pubmed/*",
        "https://pmc.ncbi.nlm.nih.gov/*",
        "https://www.ncbi.nlm.nih.gov/pmc/*"
      ],
      "js": ["data/journal-if.js", "data/library.js", "data/settings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://raw.githubusercontent.com/*"
  ]
}
